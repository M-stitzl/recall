# Ergänzt die Root-.gitignore für die Next.js-App.

# Abhängigkeiten
/node_modules
/.pnp
.pnp.*

# Build und Tests
/.next/
/out/
/build
/coverage
/test-results/
/playwright-report/
*.tsbuildinfo
next-env.d.ts

# Umgebungsvariablen: nie committen, nur die Vorlage
.env*
!.env.example

# Vercel (enthält Projekt- und Team-IDs)
.vercel

# Sonstiges
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
